# Copy to .env (gitignored). Names only; never commit values.
# Terse actor runtime (local dev binds 127.0.0.1:7100)
TERSE_ACTOR_URL=
TERSE_API_KEY=
# Hosted Relaycast REST origin, e.g. the /v1 base
RELAY_BASE_URL=
# Workspace key for the dedicated simulator Relay workspace
RELAY_WORKSPACE_KEY=
# Server-only JSON file holding per-identity Relay tokens (mode 0600)
RELAY_TOKEN_STORE_PATH=
# Model
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_MODE=
# App
APP_HOST=
APP_PORT=
PUBLIC_APP_ORIGIN=
SESSION_SECRET=
COMMAND_SIGNING_SECRET=
# Model name for live agents, e.g. gpt-5.4-mini
# Reasoning effort passed to the model, e.g. none
OPENAI_REASONING_EFFORT=
# Set to 1 to run the opt-in live model smoke test; leave unset otherwise
AGENT_LIVE_TEST=
# HOSTED (real hosted Relay) or LOCAL (fake transport, spec timings)
RELAY_TRANSPORT_PROFILE=
