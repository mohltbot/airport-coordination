{
  "name": "ghost-tower",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "packages/domain",
    "actors",
    "server",
    "web"
  ],
  "scripts": {
    "doctor": "bun scripts/doctor.ts",
    "actors:dev": "cd actors && terse actor dev",
    "actors:generate": "bun scripts/actors-generate.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p actors/tsconfig.json",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun scripts/test-integration.ts",
    "dev": "bun scripts/dev.ts",
    "dev:fixture": "GHOST_TOWER_DEV_FIXTURE=1 bun scripts/dev.ts",
    "build": "bun run --cwd web build",
    "start": "bun scripts/dev.ts --prod",
    "server": "bun server/src/main.ts",
    "demo:operator-link": "bun scripts/operator-link.ts",
    "demo:reset": "bun scripts/demo-reset.ts",
    "relay:local": "bun scripts/relay-local.ts",
    "worker": "bun server/src/simulation/worker.ts",
    "worker:local-relay": "bun --env-file=.env --env-file=.env.local-relay server/src/simulation/worker.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
